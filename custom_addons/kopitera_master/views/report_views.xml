<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="report_wizard_form" model="ir.ui.view">
    <field name="name">kopitera.report.wizard.form</field>
    <field name="model">kopitera.report.wizard</field>
    <field name="arch" type="xml">
      <form string="Laporan Rekap dan Ekspor">
        <header>
          <button name="action_export" type="object" string="Unduh Laporan" class="btn-primary" icon="fa-download"/>
        </header>
        <sheet>
          <div class="oe_title"><h1>Laporan Rekap dan Ekspor</h1></div>
          <group>
            <group string="Jenis dan Filter">
              <field name="report_type" widget="radio"/>
              <field name="division"/>
              <field name="category" invisible="report_type == 'history'"/>
              <field name="menu_status" invisible="report_type != 'catalog'"/>
              <field name="version_no" invisible="report_type != 'recipe'"/>
              <field name="menu_ids" widget="many2many_tags" invisible="report_type != 'recipe'" options="{'no_create': True}"/>
              <field name="history_action" invisible="report_type != 'history'"/>
              <field name="date_from" invisible="report_type != 'history'"/>
              <field name="date_to" invisible="report_type != 'history'"/>
            </group>
            <group string="Ekspor">
              <field name="output_format" widget="radio"/>
            </group>
          </group>
          <h4>Pratinjau</h4>
          <field name="preview_html" nolabel="1" readonly="1"/>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_report_wizard" model="ir.actions.act_window">
    <field name="name">Laporan</field>
    <field name="res_model">kopitera.report.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">current</field>
  </record>
</odoo>
